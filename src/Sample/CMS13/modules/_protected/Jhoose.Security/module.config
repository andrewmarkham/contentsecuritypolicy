<?xml version="1.0" encoding="utf-8"?>
<module loadFromBin="false" viewEngine="Razor" authorizationPolicy="episerver:cmsadmin">
    <assemblies>
        <add assembly="Jhoose.Security" />
    </assemblies>
  <!-- ... -->
  <dojo>
    <paths>
      <add name="jhoosesecurity" path="ClientResources/Scripts" />
    </paths>
  </dojo>
  <clientResources>
    <add name="jhoose.security.inlineeditor" path="ClientResources/inline-editor-bundle.js" resourceType="Script" />
  </clientResources>
  <!-- ... -->

      <clientModule initializer="jhoosesecurity/initializer">
        <moduleDependencies>
            <add dependency="Shell" />
            <add dependency="CMS" type="RunAfter" />
        </moduleDependencies>
        <requiredResources>
            <add name="jhoose.security.inlineeditor" />
        </requiredResources>
    </clientModule>

</module>
