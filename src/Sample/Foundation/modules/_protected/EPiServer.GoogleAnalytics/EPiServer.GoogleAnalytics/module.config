<?xml version="1.0" encoding="utf-8"?>
<module loadFromBin="false" clientResourceRelativePath="4.2.0">
  <assemblies>
    <add assembly="EPiServer.GoogleAnalytics" />
  </assemblies>
  <routes>
    <route url="{moduleArea}/{controller}/{action}/">
      <defaults>
        <add key="moduleArea" value="EPiServer.GoogleAnalytics" />
        <add key="controller" value="" />
        <add key="action" value="Index" />
      </defaults>
    </route>
  </routes>
  <clientResources>
    <!-- TECHNOTE: use Page.ClientResources("AnalyticsAdministration") in MVC view to access resource declared in this section -->
    <add name="googleanalytics.dashboard" path="ClientResources/dist/google-analytics.dashboard.bundle.css" resourceType="Style" />
    <add name="googleanalytics.dashboard" path="ClientResources/dist/google-analytics.dashboard.bundle.js" resourceType="Script" />
    <add name="googleanalytics.admin" path="ClientResources/dist/google-analytics.admin.bundle.css" resourceType="Style" />
    <add name="googleanalytics.admin" path="ClientResources/dist/google-analytics.admin.bundle.js" resourceType="Script" />
    <add name="googleanalytics.widget" path="ClientResources/dist/google-analytics.widget.css" resourceType="Style" />
  </clientResources>
  <dojo>
    <paths>
      <add name="epi-googleanalytics-new" path="ClientResources/dist" />
      <add name="epi-googleanalytics" path="ClientResources/Scripts" />
    </paths>
  </dojo>
  <!--<clientModule initializer="epi.example.ExampleModule">-->
  <clientModule>
    <moduleDependencies>
      <add dependency="Shell" />
      <add dependency="CMS" type="RunAfter" />
    </moduleDependencies>
    <requiredResources>
      <add name="googleanalytics.widget" />
    </requiredResources>
  </clientModule>
</module>